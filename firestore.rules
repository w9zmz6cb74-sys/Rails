rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Agents collection: stores autonomous agent wallet configurations and policies
    match /agents/{agentId} {
      allow read, write: if true;
    }

    // Transactions collection: stores on-chain activity logs and cryptographic proofs
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // Audit records collection: stores immutable cryptographic audit logs for the 10-step pipeline
    match /audit_records/{auditId} {
      allow read, write: if true;
    }

    // Pending approvals collection: stores human-in-the-loop approval queue requests
    match /pending_approvals/{approvalId} {
      allow read, write: if true;
    }
  }
}
